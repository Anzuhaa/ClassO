# ClassO deployment — copy to `.env` (repo root) and fill in real values.
# docker compose reads this file automatically. Never commit `.env`.

# --- Runtime secrets (injected into the container; never baked into images) ---
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_KEY=YOUR_SERVICE_ROLE_KEY
SUPABASE_JWT_SECRET=YOUR_JWT_SECRET

# Instructor self-promotion allowlist (comma-separated). Empty = disabled.
INSTRUCTOR_EMAILS=

# Dev-only fallback; leave empty (false) in production.
ALLOW_NO_AUTH=false

# --- Public build-time values (baked into the SPA; the anon key is public) ---
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY