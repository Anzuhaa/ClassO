# ============================================================================
# ClassO Backend — environment configuration
# Copy to `.env` and fill in real values. Never commit `.env`.
# ============================================================================

# HTTP server port.
PORT=8080

# Supabase Postgres connection string.
# Supabase Dashboard → Project Settings → Database → Connection string
# (use the "URI" format with a pooled connection: port 6543).
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Supabase project details.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_KEY=YOUR_SERVICE_ROLE_KEY

# Supabase JWT secret (used to verify auth tokens and sign storage URLs).
# Dashboard → Project Settings → API → JWT Settings → "JWT Secret".
SUPABASE_JWT_SECRET=YOUR_JWT_SECRET

# Set to true to run the backend without Supabase Auth (seeds a demo user so
# the frontend works end-to-end for local development).
ALLOW_NO_AUTH=true