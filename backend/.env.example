# ============================================================================
# ClassO Backend — environment configuration
# Copy to `.env` and fill in real values. Never commit `.env`.
# ============================================================================

# HTTP server port.
PORT=8080

# Supabase Postgres connection string.
# Supabase Dashboard → Project Settings → Database → Connection string
# (use the "URI" format with a pooled connection: port 6543).
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Supabase project details.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_KEY=YOUR_SERVICE_ROLE_KEY

# Supabase JWT secret — LEGACY HS256 only. Modern Supabase projects issue
# ES256 tokens; the backend verifies those automatically by fetching the public
# key from <SUPABASE_URL>/auth/v1/.well-known/jwks.json, so it does NOT need
# this value. It is used only to verify old HS256-signed tokens.
# Dashboard → Project Settings → API → JWT Settings → "JWT Secret".
SUPABASE_JWT_SECRET=YOUR_JWT_SECRET

# Set to true to run the backend without Supabase Auth (seeds a demo user so
# the frontend works end-to-end for local development).
ALLOW_NO_AUTH=true

# Comma-separated allowlist of emails permitted to self-promote to the
# instructor role via the "Become instructor" action. Empty = promotion disabled.
# Registration always creates students; this is the manual promotion path.
INSTRUCTOR_EMAILS=you@university.edu